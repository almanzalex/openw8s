{
  "name": "openw8s",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build:web": "bash scripts/sync-catalog.sh && npm run build --workspace=web",
